{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skaylon-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skaylon-web"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://skaylon.com"
  },
  // ISR (open-next.config.ts): page cache in KV, revalidation tags in D1.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "eda3e36d18064e2ab925a15abf203e27"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "skaylon-tag-cache",
      "database_id": "2c309d25-0db8-4b10-b872-ca603fcb9143"
    }
  ],
  // Contact form: 5 submissions per minute per IP, shared across isolates.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // First-party conversion events (/api/event). No IPs or identifiers stored.
  // DISABLED until Analytics Engine is enabled once in the Cloudflare dashboard
  // (Workers → Analytics Engine). Uncomment then; /api/event drops events
  // harmlessly while the binding is absent.
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "EVENTS",
  //     "dataset": "skaylon_events"
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
