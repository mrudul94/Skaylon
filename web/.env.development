# Loaded ONLY by `next dev`. Never put dev values in .env.local: Next loads
# .env.local for production builds too and it overrides .env.production
# (that once shipped http://localhost:3000 as the canonical URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare's published Turnstile TEST keys (always pass, not secrets), so the
# contact form and the enquiry pop-up work locally. Enquiries are only logged
# (CONTACT_DRY_RUN), never emailed. Production keys are set separately.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_DRY_RUN=1
