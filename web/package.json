{
  "name": "skaylon-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/run-verify.mjs",
    "bake:env": "node --experimental-strip-types --no-warnings scripts/bake-environment.mjs",
    "posters": "node scripts/render-posters.mjs",
    "verify:routes": "node --experimental-strip-types --no-warnings scripts/verify-routes.mts",
    "verify:bundle": "node --experimental-strip-types --no-warnings scripts/verify-bundle.mts",
    "test:e2e": "node scripts/e2e.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@sanity/client": "8.6.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "0.186.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "lighthouse": "12.8.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.134.0"
  }
}
